<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open accessibility settings" />

        <Switch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hotkey active" />

        <TextView
            android:id="@+id/hotkeyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <Button
            android:id="@+id/setHotkey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set hotkey" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="OCR engine"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <RadioGroup
            android:id="@+id/engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/engineLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On-device (ML Kit): offline, private, less accurate" />

            <RadioButton
                android:id="@+id/engineLens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Google Lens: much more accurate, needs internet, sends the captured image to Google" />
        </RadioGroup>

        <TextView
            android:id="@+id/regionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickRegion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pick region" />

            <Button
                android:id="@+id/clearRegion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Full screen" />
        </LinearLayout>

        <Switch
            android:id="@+id/keepNewlines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keep line breaks" />

        <Switch
            android:id="@+id/copyToClipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Copy to clipboard" />

        <Switch
            android:id="@+id/showToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show captured text as a toast" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="After capture"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <RadioGroup
            android:id="@+id/dictionaryMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/dictOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Just copy" />

            <RadioButton
                android:id="@+id/dictOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show dictionary over the game (B, Back or the hotkey closes it)" />

            <RadioButton
                android:id="@+id/dictLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Look up in your Yomitan dictionaries over the game, offline (tap a character or use D-pad left/right to pick the word)" />

            <RadioButton
                android:id="@+id/dictBrowser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open dictionary in the browser" />
        </RadioGroup>

        <EditText
            android:id="@+id/dictionaryUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dictionary URL, {text} = captured text"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            android:id="@+id/dictionaryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/loadDictionary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load dictionary database" />

        <LinearLayout
            android:id="@+id/dictionaryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Translate hotkey"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/translateHotkeyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setTranslateHotkey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Set translate hotkey" />

            <Button
                android:id="@+id/clearTranslateHotkey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear" />
        </LinearLayout>

        <EditText
            android:id="@+id/translateUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Translator URL, {text} = captured text"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/deeplKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DeepL API key (empty = use the translator URL)"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/deeplTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DeepL target language, e.g. EN-US, EN-GB, DE"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Last result"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:id="@+id/lastResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
